<?xml version="1.0" encoding="utf-8"?>
<!--
  Copyright (C) 2024 The Android Open Source Project

  ARDA_MEDIA_PHASE1GB_CONTROLLED ready=true

  Two-page media surface:
    page 0 = Android-Auto-inspired Now Playing
    page 1 = real queue, or Media Source/history when queue is unavailable

  The SystemUI back button remains authoritative. The media surface has no duplicate back button.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:tag="ARDA_MEDIA_PHASE1H6_CONTROL_TUNING ready=true"
    app:cardBackgroundColor="?oemColorSurfaceContainerHigh"
    app:cardCornerRadius="?mediaCardCornerRadius"
    app:cardElevation="0dp">

    <com.android.car.carlauncher.homescreen.audio.media.ArdaMediaSwipeLayout
        android:id="@+id/motion_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Compatibility background view used by the inherited controller. -->
        <FrameLayout
            android:id="@+id/empty_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?oemColorSurfaceContainerHigh"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Full-card artwork; the gradient below keeps metadata and controls readable. -->
        <ImageView
            android:id="@+id/album_art"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/media_card_default_album_art"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/arda_media_art_scrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/arda_media_art_scrim"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Kept for the inherited controller/MotionScene resource contract. -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="0dp" />

        <ImageView
            android:id="@+id/media_widget_app_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/arda_media_round_button_background"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:elevation="4dp"
            android:padding="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- The queue/page button is the only visible top-right media control. -->
        <LinearLayout
            android:id="@+id/button_panel_background"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@android:color/transparent"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/overflow_button"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:background="@android:color/transparent"
                android:contentDescription="@null"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/queue_button"
                android:visibility="gone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/arda_media_round_button_background"
                android:contentDescription="@string/media_card_queue_header_title"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_queue"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/history_button"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:background="@android:color/transparent"
                android:contentDescription="@null"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Bottom-oriented compact metadata, as in the Android Auto reference. -->
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="2dp"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:text="@string/metadata_default_title"
            android:textAlignment="viewStart"
            android:textAppearance="?oemTextAppearanceTitleMedium"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toTopOf="@id/subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textAppearance="?oemTextAppearanceBodyMedium"
            android:textColor="#D9FFFFFF"
            app:layout_constraintBottom_toTopOf="@id/playback_seek_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.android.car.carlauncher.homescreen.audio.media.ArdaSquigglySeekBar
            android:id="@+id/playback_seek_bar"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="0dp"
            android:paddingTop="4dp"
            android:paddingEnd="0dp"
            android:paddingBottom="4dp"
            android:progressBackgroundTint="#70FFFFFF"
            android:progressTint="@android:color/white"
            android:splitTrack="false"
            android:thumb="@null"
            app:layout_constraintBottom_toTopOf="@id/play_pause_button"
            app:layout_constraintEnd_toStartOf="@id/playback_time"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/playback_time"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="?oemTextAppearanceBodySmall"
            android:textColor="#E6FFFFFF"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/playback_seek_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/playback_seek_bar" />

        <com.android.car.media.common.ContentFormatView
            android:id="@+id/content_format"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/playback_seek_bar"
            app:logoSize="small"
            app:logoTint="?oemColorOnSurfaceVariant" />

        <!-- Android Auto compact order: large play/pause, previous, next. -->
        <ImageButton
            android:id="@+id/play_pause_button"
            android:layout_width="92dp"
            android:layout_height="58dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/arda_media_play_primary_background"
            android:contentDescription="@null"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play_pause_selector"
            android:tint="#17191C"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/playback_action_id1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="2dp"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:cropToPadding="true"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:tint="@android:color/white"
            app:layout_constraintBottom_toBottomOf="@id/play_pause_button"
            app:layout_constraintStart_toEndOf="@id/play_pause_button"
            app:layout_constraintTop_toTopOf="@id/play_pause_button" />

        <ImageButton
            android:id="@+id/playback_action_id2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:cropToPadding="true"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:tint="@android:color/white"
            app:layout_constraintBottom_toBottomOf="@id/play_pause_button"
            app:layout_constraintStart_toEndOf="@id/playback_action_id1"
            app:layout_constraintTop_toTopOf="@id/play_pause_button" />

        <!-- Page 1. MotionScene places this just outside the right edge until opened. -->
        <LinearLayout
            android:id="@+id/media_card_panel_content_container"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/arda_media_secondary_page_background"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Compatibility ID retained; no duplicate back affordance is rendered. -->
            <FrameLayout
                android:id="@+id/media_card_panel_handlebar"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <TextView
                    android:id="@+id/arda_media_secondary_page_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/media_card_queue_header_title"
                    android:textAppearance="?oemTextAppearanceTitleMedium"
                    android:textColor="@android:color/white" />

                <View
                    android:id="@+id/arda_media_page_dot_now_playing"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/arda_widget_page_dot_inactive" />

                <View
                    android:id="@+id/arda_media_page_dot_secondary"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/arda_widget_page_dot_active" />
            </LinearLayout>

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </com.android.car.carlauncher.homescreen.audio.media.ArdaMediaSwipeLayout>
</androidx.cardview.widget.CardView>
